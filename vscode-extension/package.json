{
  "name": "devscriptor",
  "displayName": "Devscriptor",
  "description": "AI-powered code analysis and semantic search",
  "version": "0.1.0",
  "publisher": "vladimirpesic",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Programming Languages",
    "Machine Learning",
    "Debuggers",
    "Other"
  ],
  "keywords": [
    "code analysis",
    "semantic search",
    "AI",
    "MCP",
    "dead code",
    "complexity"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "devscriptor.scanWorkspace",
        "title": "Scan Workspace",
        "category": "Devscriptor"
      },
      {
        "command": "devscriptor.semanticSearch",
        "title": "Search",
        "category": "Devscriptor",
        "icon": "$(search)"
      },
      {
        "command": "devscriptor.findDeadCode",
        "title": "Find Dead Code",
        "category": "Devscriptor"
      },
      {
        "command": "devscriptor.analyzeComplexity",
        "title": "Analyze Complexity",
        "category": "Devscriptor"
      },
      {
        "command": "devscriptor.showCallGraph",
        "title": "Show Call Graph",
        "category": "Devscriptor"
      },
      {
        "command": "devscriptor.gotoDefinition",
        "title": "Go to Definition (Enhanced)",
        "category": "Devscriptor"
      },
      {
        "command": "devscriptor.findReferences",
        "title": "Find References (Enhanced)",
        "category": "Devscriptor"
      },
      {
        "command": "devscriptor.startMcpServer",
        "title": "Connect to the Shared Devscriptor",
        "category": "Devscriptor"
      },
      {
        "command": "devscriptor.stopMcpServer",
        "title": "Disconnect from the Shared Devscriptor",
        "category": "Devscriptor"
      },
      {
        "command": "devscriptor.updateBinary",
        "title": "Check for Devscriptor Updates",
        "category": "Devscriptor"
      },
      {
        "command": "devscriptor.showStatus",
        "title": "Show Status",
        "category": "Devscriptor"
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "devscriptor.mcp",
        "label": "Devscriptor"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "devscriptor.analysis",
          "name": "Devscriptor Analysis",
          "when": "devscriptor.enabled",
          "icon": "$(symbol-misc)"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "devscriptor",
          "title": "Devscriptor",
          "icon": "$(symbol-misc)"
        }
      ]
    },
    "configuration": {
      "title": "Devscriptor",
      "properties": {
        "devscriptor.binaryPath": {
          "type": "string",
          "default": "",
          "description": "Path to devscriptor binary (auto-detected if empty)"
        },
        "devscriptor.databasePath": {
          "type": "string",
          "default": "devscriptor.db",
          "description": "Path to the analysis database, relative to the first workspace folder unless absolute. The default is the database `devscriptor scan` writes, so the extension shares its index; an agent whose MCP client starts `devscriptor mcp --database devscriptor.db` in the folder shares its Devscriptor process too"
        },
        "devscriptor.autoScan": {
          "type": "boolean",
          "default": true,
          "description": "Automatically scan workspace on open"
        },
        "devscriptor.enableSemanticSearch": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Search by meaning: **Devscriptor: Search** finds code by what it does, with Devscriptor's embedding model (downloaded on first use, ~150 MB). Off, it finds code by name, without the model."
        },
        "devscriptor.mcpServer.enabled": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Offer the workspace's Devscriptor to VS Code's AI assistants (agent mode in chat) as an MCP server: `devscriptor mcp`, which shares the extension's Devscriptor process. Needs VS Code 1.101 or newer."
        },
        "devscriptor.lsp.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "**Go to Definition (Enhanced)** and **Find References (Enhanced)**, answered by the language servers Devscriptor runs. Off, the two commands are hidden."
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "devscriptor.gotoDefinition",
          "group": "navigation",
          "when": "editorHasSelection && config.devscriptor.lsp.enabled"
        },
        {
          "command": "devscriptor.findReferences",
          "group": "navigation",
          "when": "editorHasSelection && config.devscriptor.lsp.enabled"
        }
      ],
      "view/title": [
        {
          "command": "devscriptor.scanWorkspace",
          "when": "view == devscriptor.analysis",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "devscriptor.gotoDefinition",
          "when": "config.devscriptor.lsp.enabled"
        },
        {
          "command": "devscriptor.findReferences",
          "when": "config.devscriptor.lsp.enabled"
        }
      ]
    },
    "keybindings": [
      {
        "command": "devscriptor.semanticSearch",
        "key": "ctrl+shift+s"
      },
      {
        "command": "devscriptor.gotoDefinition",
        "key": "ctrl+alt+g",
        "when": "config.devscriptor.lsp.enabled"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "clean": "node -e \"require('fs').rmSync('out', { recursive: true, force: true })\"",
    "compile": "npm run clean && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "test:unit": "npm run compile && mocha out/test/suite/cliOutput.test.js out/test/suite/mcpOutput.test.js out/test/suite/mcpClient.test.js out/test/suite/sharedServer.test.js out/test/suite/releases.test.js out/test/suite/settings.test.js",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "16.x",
    "@types/vscode": "^1.74.0",
    "@types/which": "^3.0.4",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "@vscode/test-electron": "^2.2.0",
    "@vscode/vsce": "^2.15.0",
    "eslint": "^8.28.0",
    "mocha": "^10.8.2",
    "typescript": "^4.9.4"
  },
  "dependencies": {
    "which": "^4.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vladimirpesic/devscriptor.git"
  },
  "bugs": {
    "url": "https://github.com/vladimirpesic/devscriptor/issues"
  },
  "homepage": "https://github.com/vladimirpesic/devscriptor#readme",
  "license": "Apache-2.0"
}
