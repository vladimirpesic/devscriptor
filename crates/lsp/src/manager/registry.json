{
  "servers": {
    "rust-analyzer": {
      "id": "rust-analyzer",
      "name": "Rust Analyzer",
      "languages": [
        "rust"
      ],
      "source": {
        "type": "github-release",
        "repo": "rust-lang/rust-analyzer",
        "asset_pattern": "rust-analyzer-{arch}-{os}.gz"
      },
      "size_mb": 42,
      "bin_path": "bin/rust-analyzer",
      "license": "MIT OR Apache-2.0",
      "license_files": [
        {
          "url": "https://raw.githubusercontent.com/rust-lang/rust-analyzer/c59cdaa4c26ffe036a3403e4948f1681995d4125/LICENSE-MIT",
          "sha256": "23f18e03dc49df91622fe2a76176497404e46ced8a715d9d2b67a7446571cca3"
        },
        {
          "url": "https://raw.githubusercontent.com/rust-lang/rust-analyzer/c59cdaa4c26ffe036a3403e4948f1681995d4125/LICENSE-APACHE",
          "sha256": "62c7a1e35f56406896d7aa7ca52d0cc0d272ac022b5d2796e7d6905db8a3636a"
        }
      ],
      "extensions": [
        "rs"
      ],
      "heuristics": {
        "markers": [
          "Cargo.toml",
          "Cargo.lock"
        ],
        "max_depth": 3
      },
      "args": [],
      "initialization_options": {
        "cargo": {
          "targetDir": true
        }
      }
    },
    "clangd": {
      "id": "clangd",
      "name": "clangd",
      "languages": [
        "c",
        "cpp",
        "cuda",
        "objective-cpp",
        "objective-c"
      ],
      "source": {
        "type": "github-release",
        "repo": "clangd/clangd",
        "asset_pattern": "clangd-{platform}-{version}.zip",
        "published_for": [
          "linux-x86_64",
          "macos-x86_64",
          "macos-aarch64",
          "windows-x86_64"
        ]
      },
      "size_mb": 56,
      "bin_path": "bin/clangd",
      "license": "Apache-2.0",
      "license_files": [
        {
          "url": "https://raw.githubusercontent.com/llvm/llvm-project/17501a9d4845b6f3082f449728757f9a3ad15072/clang-tools-extra/LICENSE.TXT",
          "sha256": "ebcd9bbf783a73d05c53ba4d586b8d5813dcdf3bbec50265860ccc885e606f47"
        }
      ],
      "extensions": [
        "c",
        "cpp",
        "cc",
        "cxx",
        "h",
        "hpp",
        "cu",
        "cuh",
        "mm",
        "m"
      ],
      "heuristics": {
        "markers": [
          "compile_commands.json",
          "compile_flags.txt",
          ".clangd",
          "CMakeLists.txt",
          "Makefile"
        ],
        "max_depth": 3
      },
      "args": [
        "--resource-dir={server_dir}/resource-dir",
        "--compile-commands-dir={compile_commands_dir}"
      ]
    },
